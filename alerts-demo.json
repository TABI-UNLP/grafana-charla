[
  {
    "uid": "charla-calor",
    "title": "Calor en Buenos Aires",
    "ruleGroup": "charla",
    "folderUID": "charla",
    "condition": "B",
    "for": "0s",
    "noDataState": "NoData",
    "execErrState": "Error",
    "labels": { "severity": "warning", "demo": "charla" },
    "annotations": {
      "summary": "La temperatura actual en Buenos Aires superó el umbral",
      "description": "Dato de Open-Meteo. Para dispararla en vivo, bajar el umbral por debajo de la temperatura actual."
    },
    "data": [
      {
        "refId": "A",
        "datasourceUid": "public-json",
        "relativeTimeRange": { "from": 600, "to": 0 },
        "model": {
          "refId": "A",
          "type": "json",
          "source": "url",
          "parser": "backend",
          "format": "table",
          "url": "https://api.open-meteo.com/v1/forecast?latitude=-34.6037&longitude=-58.3816&current=temperature_2m&timezone=UTC",
          "url_options": { "method": "GET" },
          "root_selector": "current",
          "columns": [{ "selector": "temperature_2m", "text": "Temperatura", "type": "number" }]
        }
      },
      {
        "refId": "B",
        "datasourceUid": "__expr__",
        "relativeTimeRange": { "from": 0, "to": 0 },
        "model": {
          "refId": "B",
          "type": "threshold",
          "expression": "A",
          "conditions": [{ "evaluator": { "type": "gt", "params": [30] } }]
        }
      }
    ]
  },
  {
    "uid": "charla-sismo",
    "title": "Sismo fuerte en la última semana",
    "ruleGroup": "charla",
    "folderUID": "charla",
    "condition": "B",
    "for": "0s",
    "noDataState": "NoData",
    "execErrState": "Error",
    "labels": { "severity": "critical", "demo": "charla" },
    "annotations": {
      "summary": "Hubo al menos un sismo de magnitud 6.5 o más en los últimos 7 días",
      "description": "Dato del USGS. Calcula la magnitud máxima del feed con JSONata."
    },
    "data": [
      {
        "refId": "A",
        "datasourceUid": "public-json",
        "relativeTimeRange": { "from": 600, "to": 0 },
        "model": {
          "refId": "A",
          "type": "json",
          "source": "url",
          "parser": "backend",
          "format": "table",
          "url": "https://earthquake.usgs.gov/earthquakes/feed/v1.0/summary/4.5_week.geojson",
          "url_options": { "method": "GET" },
          "root_selector": "$map([$max(features.properties.mag)], function($v) { {\"max\": $v} })",
          "columns": [{ "selector": "max", "text": "Magnitud máxima", "type": "number" }]
        }
      },
      {
        "refId": "B",
        "datasourceUid": "__expr__",
        "relativeTimeRange": { "from": 0, "to": 0 },
        "model": {
          "refId": "B",
          "type": "threshold",
          "expression": "A",
          "conditions": [{ "evaluator": { "type": "gt", "params": [6.4] } }]
        }
      }
    ]
  }
]
